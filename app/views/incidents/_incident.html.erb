<tr class="even:bg-gray-50">
  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-3"><%= incident.title %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= incident.description %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= incident.severity %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <% if incident.open? %>
      <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-green-600/20 ring-inset">Open</span>
    <% else %>
      <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-red-600/20 ring-inset">Resolved</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= incident.created_by %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= incident.workspace_id %></td>
</tr>
