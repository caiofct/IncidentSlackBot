<% content_for :title, "Incidents" %>

<header>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900">Incidents</h1>
  </div>
</header>

<div class="w-full px-4 sm:px-6 lg:px-8">
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div id="incidents" class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <%= render partial: "incidents_table", locals: { incidents: @incidents } %>
      </div>
    </div>
  </div>
</div>
